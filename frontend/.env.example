# Base URL of the deployed backend (no trailing slash, no /api suffix).
# Local dev picks this up from .env.development automatically.
# Production builds (Vercel) pick it up from .env.production — update that
# file once you know your Render service's URL, or override it by setting
# VITE_API_URL in the Vercel project's Environment Variables instead.
VITE_API_URL=https://your-backend.onrender.com
