# CockroachDB Cloud connection string (Console -> Connect)
DATABASE_URL=

# Which provider answers the agent's reasoning + tool-calling loop
# groq (default) | anthropic | bedrock
AGENT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=

ANTHROPIC_API_KEY=

BEDROCK_MODEL_ID=

# Which provider generates incident embeddings
# bedrock (default) | openai
EMBEDDING_PROVIDER=bedrock
OPENAI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CockroachDB Cloud Managed MCP Server
COCKROACH_MCP_URL=
COCKROACH_MCP_TOKEN=

# Comma-separated list of allowed origins for CORS in production,
# e.g. https://your-app.vercel.app,https://your-app-git-preview.vercel.app
# Leave unset for local dev (allows all origins).
CORS_ORIGIN=

# Render sets this automatically — no need to set it yourself
PORT=3001
